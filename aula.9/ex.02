from flask import Flask, jsonify

app = Flask(__name__)

# "Banco de dados" em memória (uma lista de dicionários)
produtos = [
    {"id": 1, "nome": "maçaneta de porta", "preco": 249.90, "disponivel": True},
    {"id": 2, "nome": "moletom nike", "preco": 129.00, "disponivel": True},
    {"id": 3, "nome": "kit turbo", "preco": 899.00, "disponivel": False},
    {"id": 4, "nome": "Headset HyperX", "preco": 349.90, "disponivel": True}
]

@app.route("/produtos")
def listar_produtos():
    return jsonify(produtos)

if __name__ == "__main__":
    app.run(debug=True)
