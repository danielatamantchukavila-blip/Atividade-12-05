class Forma:
    def area(self):
        return 0

class Triangulo(Forma):
    def __init__(self, base, altura):
        self.base = base
        self.altura = altura

    def area(self):
        return (self.base * self.altura) / 2

class Quadrado(Forma):
    def __init__(self, lado):
        self.lado = lado

    def area(self):
        return self.lado * self.lado

formas = [
    Triangulo(6, 3),
    Quadrado(5)
]

for forma in formas:
    nome_da_forma = forma.__class__.__name__
    print(f"Área do {nome_da_forma}: {forma.area()}")
