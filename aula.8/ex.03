from flask import Flask
from datetime import date

app = Flask(__name__)

@app.route("/saudacao")
def saudacao():
    return "Olá! Seja muito bem-vindo(a) à minha API Flask!"

@app.route("/data")
def data_atual():
    hoje = date.today()
    return f"Data de hoje: {hoje}"

if __name__ == "__main__":
    app.run(debug=True)
